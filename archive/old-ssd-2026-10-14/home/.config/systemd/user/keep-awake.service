[Unit]
Description=Prevent automatic lid sleep
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=handle-lid-switch --who=keep-awake --why="Keep lid closure from suspending automatically" --mode=block /usr/bin/sleep infinity
Restart=on-failure

[Install]
WantedBy=default.target
