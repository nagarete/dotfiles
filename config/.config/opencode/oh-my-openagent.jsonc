{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "sisyphus_agent": {
    "default_builder_enabled": true
  },
  "agents": {
    "sisyphus": {
      "model": "opencode-go/kimi-k2.7-code",
      "ultrawork": { "model": "opencode-go/kimi-k2.7-code" },
      "fallback_models": [
        "opencode-go/qwen3.7-plus",
        "opencode-go/qwen3.6-plus"
      ]
    },
    "sisyphus-junior": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": [
        "opencode-go/minimax-m2.7",
        "opencode-go/minimax-m3"
      ]
    },
    "prometheus": {
      "model": "opencode-go/gpt-5.6-luna",
      "fallback_models": [
        "opencode-go/kimi-k2.6",
        "opencode-go/qwen3.7-plus"
      ]
    },
    "atlas": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": [
        "opencode-go/minimax-m3",
        "opencode-go/kimi-k2.6"
      ]
    },
    "hephaestus": {
      "model": "opencode-go/gpt-5.6-luna",
      "fallback_models": [
        "opencode-go/kimi-k2.6",
        "opencode-go/qwen3.7-plus"
      ]
    },
    "metis": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": [
        "opencode-go/mimo-v2.5-pro",
        "opencode-go/kimi-k2.6"
      ]
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": [
        "opencode-go/deepseek-v4-flash",
        "opencode-go/minimax-m3"
      ]
    },
    "librarian": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": [
        "opencode-go/deepseek-v4-flash",
        "opencode-go/minimax-m3"
      ]
    },
    "oracle": {
      "model": "opencode-go/gpt-5.6-luna",
      "fallback_models": [
        "opencode-go/qwen3.6-plus",
        "opencode-go/mimo-v2.5-pro"
      ]
    },
    "momus": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": [
        "opencode-go/kimi-k2.7-code"
      ]
    },
    "multimodal-looker": {
      "model": "opencode-go/mimo-v2.5-pro",
      "variant": "high",
      "fallback_models": [
        "opencode-go/kimi-k2.6",
        "opencode-go/kimi-k2.6"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": ["opencode-go/qwen3.7-plus", "opencode-go/mimo-v2.5"]
    },
    "artistry": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": ["opencode-go/qwen3.7-plus", "opencode-go/mimo-v2.5"]
    },
    "ultrabrain": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": ["opencode-go/kimi-k2.7-code", "opencode-go/qwen3.7-plus"]
    },
    "deep": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": ["opencode-go/qwen3.7-plus", "opencode-go/kimi-k2.6"]
    },
    "quick": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": ["opencode-go/minimax-m2.7", "opencode-go/minimax-m3"]
    },
    "unspecified-low": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": ["opencode-go/minimax-m2.7", "opencode-go/minimax-m3"]
    },
    "unspecified-high": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": ["opencode-go/kimi-k2.7-code"]
    },
    "writing": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": ["opencode-go/minimax-m2.7", "opencode-go/kimi-k2.6"]
    },
    "research": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": ["opencode-go/kimi-k2.6", "opencode-go/qwen3.7-plus"],
      "prompt_append": "Use current sources when available. Separate verified facts from inference, cite important claims, and state uncertainty explicitly."
    },
    "brainstorming": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": ["opencode-go/qwen3.7-plus", "opencode-go/kimi-k2.6"],
      "prompt_append": "Generate diverse ideas before judging them. Then rank the strongest options by originality, feasibility, and likely impact."
    },
    "youtube": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": ["opencode-go/minimax-m3", "opencode-go/kimi-k2.6"],
      "prompt_append": "Optimize for audience retention without clickbait. Include a hook, structure, narration, visual suggestions, title options, thumbnail concepts, and fact-check notes."
    },
    "finance": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": ["opencode-go/kimi-k2.6", "opencode-go/qwen3.7-plus"],
      "prompt_append": "Treat this as financial research, not personalized advice. Date every data point, prefer primary sources, identify assumptions and risks, and distinguish facts from forecasts."
    },
    "general": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": ["opencode-go/qwen3.7-plus", "opencode-go/kimi-k2.6"]
    }
  },
  "background_task": {
    "providerConcurrency": {
      "opencode-go": 10
    },
    "modelConcurrency": {
      "opencode-go/minimax-m2.7": 20,
      "opencode-go/deepseek-v4-flash": 16,
      "opencode-go/kimi-k2.6": 14,
      "opencode-go/kimi-k2.7-code": 12,
      "opencode-go/qwen3.7-plus": 12,
      "opencode-go/minimax-m3": 10,
      "opencode-go/mimo-v2.5": 4,
      "opencode-go/mimo-v2.5(high)": 2,
      "opencode-go/mimo-v2.5(medium)": 3
    }
  },
  "experimental": {
    "aggressive_truncation": true,
    "task_system": true
  }
}
